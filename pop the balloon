import turtle
import random
import time

# scr setup
scr = turtle.Screen()
scr.bgcolor("pink")
scr.setup(800,600)
scr.tracer(0)

#player setup
p = turtle.Turtle()
p.shape("triangle")
p.color("red")
p.penup()
p.goto(0,-250)
p.setheading(90)

#score display
score =  0
score_display = turtle.Turtle()
score_display.hideturtle()
score_display.penup()
score_display.goto(-380,-280)
score_display.color("brown")
score_display.write(f"Score: {score}", font = ("Arial", 16 , "normal"))

#balloons list
balloons = []

#game variables
game_speed = 0.02
difficulty_increase = 0.001
spawn_interval = 2
last_spawn_time = time.time()
running = True

def move_left():
    x = p.xcor() -40
    if x > -300:
        p.setx(x)

def move_right():
    x = p.xcor() +40
    if x < 300:
        p.setx(x)

#func. to spawn bAlLoOnS
def spawn_balloon():
    balloon = turtle.Turtle()
    balloon.penup()
    balloon.shape("circle")
    balloon.color(random.choice(["purple","red","blue","yellow","green","orange","white"]))
    balloon.goto(random.randint(-350,350),random.randint(200,300))
    balloon.speed = random.uniform(1, 3)
    if random.random() < 0.2:
        #20% chance to be a BoMb
        balloon.color("black")
        balloon.is_bomb = True
    else:
        balloon.is_bomb = False
        balloons.append(balloon)

def update_score(points):
    global score
    score += points
    score_display.write(f"Score: {score}",font=("Arial", 16,"normal"))

def game_over():
    global running
    running = False
    game_over_display = turtle.Turtle()
    game_over_display.hideturtle()
    game_over_display.color("red")
    game_over_display.write("gAmE oVeR!!!", align="center",font=("Arail",36,"bold"))
    scr.update()
    time.sleep(2)
    scr.bye()

#key bindings
scr.listen()
scr.onkey(move_left, "Left")
scr.onkey(move_right, "Right")

#game loop
while running:
    scr.update()
    current_time = time.time()
    #spawn balloons at intervals
    if current_time - last_spawn_time > spawn_interval:
        spawn_balloon
        last_spawn_time = current_time

    #move ballons
    for balloon in balloons[:]:
        balloon.sety(balloon.ycor() - balloon.speed)
        if balloon.ycor() < -300:
            balloons.remove(balloon)
            balloon.hideturtle()

        #check for collision
        if p.distance(balloon)<30:
            if balloon.is_bomb:
                game_over()
            else:
                update_score(10)
                balloons.remove(balloon)
                balloon.hideturtle()

    #increase difficulty over time
    game_speed = max(0.005, game_speed - difficulty_increase)
    spawn_interval = max(0.5,spawn_interval - 0.0005)
    time.sleep(game_speed)




 

