def move_left():
    x = p.xcor() -30
    if x > -340:
        p.setx(x)

def move_right():
    x = p.xcor() +30
    if x < 340:
        p.setx(x)

def spawn_balloon():
    balloon = turtle.Turtle()
    balloon.penup()
    balloon.shape("circle")
    balloon.color(random.choice(["red", "green", "blue", "pink", "orange", "yellow", "light blue"]))
    balloon.goto(random.randint(-340, 340),random.randint(200,300))
    balloon.speed = random.uniform(1,3)
    if random.random() < 0.2: # 20% chance to be a bomb
        balloon.color("black")
        balloon.is_bomb = True
    else:
        balloon.is_bomb = False
    balloons.append(balloon)

def update_score(points):
    global score
    score += points
    score_display.clear()
    score_display.write(f"Score: {score}",font=("Arail",26,"normal"))

